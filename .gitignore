.venv/
__pycache__/
.DS_Store
.onshape_cache.json
manifest.json
tmp/

# Camtasia bundles carry their raw source FOOTAGE beside a small .tscproj
# timeline — Compile.cmproj is 85 MB, of which 85 MB is two .mov files and
# 0.1 MB is the edit. Video does not delta-compress, so every re-edit would
# add its full size to history permanently, and history cannot be slimmed
# by deleting later. Keep the timeline in git, the footage in your backups.
# (cascades/FCM/Camtasia/'s .MOV predates this rule and stays tracked —
# ignoring a path does not untrack what is already in.)
# (a mid-pattern slash anchors to the repo root, hence the leading **/)
**/*.cmproj/media/
# Camtasia's autosave copy of the timeline. It churns on every save and is
# never the file you want — the one committed in 3627c5b turned into an
# 823-line deletion the next time Camtasia touched it. No **/ needed: a
# pattern with no slash in it already matches at any depth.
~*.tscproj

# Generated components. Reproducible from cad/ with zero API calls, and a
# pusher is ~115 KB of mesh that does not delta-compress — regenerate, do not
# commit. individual/ stays the tracked ground truth.
build/
